{
  "info": {
    "_postman_id": "payflow-platform-v1-collection",
    "name": "PayFlow Platform API",
    "description": "Production Postman Collection for PayFlow Distributed Payment & Digital Wallet Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "jwtToken", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkOGI2YjQ2OS1jYzNlLTRlNzEtOTNiNy04ZjViNjRhZGFmMDUiLCJyb2xlcyI6WyJST0xFX1VTRVIiXSwiaWF0IjoxNzI1MTEwNDAwLCJleHAiOjE3MjUxMTEzMDB9.signature", "type": "string" },
    { "key": "adminJwtToken", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbi0wMDAwLTAwMDAtMDAwMC0wMDAwMDAwMDAwMDAiLCJyb2xlcyI6WyJST0xFX0FETUlOIl0sImlhdCI6MTcyNTExMDQwMCwiZXhwIjoxNzI1MTExMzAwfQ.signature", "type": "string" },
    { "key": "merchantApiKey", "value": "pf_live_y7K3mPq8R1tV4wX9zB2dE5gH0jL6nS3vF8xQ1aC4eN7", "type": "string" },
    { "key": "userId", "value": "d8b6b469-cc3e-4e71-93b7-8f5b64adaf05", "type": "string" },
    { "key": "walletId", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "recipientWalletId", "value": "22222222-2222-2222-2222-222222222222", "type": "string" },
    { "key": "merchantId", "value": "a5bb0fa2-ed11-47be-9f6d-1c4da7142158", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@payflow.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"phone\": \"+15551234567\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@payflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"rt_live_9f8e2cdaf442ca63866d7f6e1fdac\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"rt_live_9f8e2cdaf442ca63866d7f6e1fdac\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. User Management",
      "item": [
        {
          "name": "Get Current Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "me"] }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Update User Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status?status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "status"],
              "query": [{ "key": "status", "value": "ACTIVE" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Wallet Service",
      "item": [
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"currency\": \"INR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/wallets", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets"] }
          }
        },
        {
          "name": "Get Wallet Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "{{walletId}}"] }
          }
        },
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/balance", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "{{walletId}}", "balance"] }
          }
        },
        {
          "name": "Top-Up Wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000.00,\n  \"currency\": \"INR\",\n  \"referenceId\": \"TX-TOPUP-2026-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/top-up", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "{{walletId}}", "top-up"] }
          }
        },
        {
          "name": "Withdraw Funds (Conditional Debit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 250.00,\n  \"currency\": \"INR\",\n  \"referenceId\": \"TX-WITHDRAW-2026-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/withdraw", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "{{walletId}}", "withdraw"] }
          }
        },
        {
          "name": "Freeze Wallet (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/freeze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "{{walletId}}", "freeze"] }
          }
        },
        {
          "name": "Unfreeze Wallet (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/unfreeze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "{{walletId}}", "unfreeze"] }
          }
        }
      ]
    },
    {
      "name": "4. Payment & Saga Orchestration",
      "item": [
        {
          "name": "Initiate Payment / P2P Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Idempotency-Key", "value": "PAY-TX-987654321" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderWalletId\": \"{{walletId}}\",\n  \"recipientWalletId\": \"{{recipientWalletId}}\",\n  \"amount\": 250.00,\n  \"currency\": \"INR\",\n  \"paymentType\": \"P2P_TRANSFER\",\n  \"idempotencyKey\": \"PAY-TX-987654321\",\n  \"description\": \"Dinner split settlement\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments"] }
          }
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/payments/98765432-1234-5678-9abc-def012345678", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "98765432-1234-5678-9abc-def012345678"] }
          }
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer return\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/98765432-1234-5678-9abc-def012345678/refund", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "98765432-1234-5678-9abc-def012345678", "refund"] }
          }
        }
      ]
    },
    {
      "name": "5. Ledger & Accounting",
      "item": [
        {
          "name": "Record Balanced Journal Entry (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"98765432-1234-5678-9abc-def012345678\",\n  \"reference\": \"SETTLE-001\",\n  \"lines\": [\n    {\n      \"walletId\": \"{{walletId}}\",\n      \"entryType\": \"DEBIT\",\n      \"amountMinor\": 25000,\n      \"currency\": \"INR\"\n    },\n    {\n      \"walletId\": \"{{recipientWalletId}}\",\n      \"entryType\": \"CREDIT\",\n      \"amountMinor\": 25000,\n      \"currency\": \"INR\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/ledger/entries", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ledger", "entries"] }
          }
        },
        {
          "name": "Get Journal by Transaction ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/ledger/transactions/98765432-1234-5678-9abc-def012345678", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ledger", "transactions", "98765432-1234-5678-9abc-def012345678"] }
          }
        },
        {
          "name": "Get Wallet Statement",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/wallets/{{walletId}}?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ledger", "wallets", "{{walletId}}"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Verify Ledger Integrity (Audit)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/ledger/audit/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ledger", "audit", "verify"] }
          }
        }
      ]
    },
    {
      "name": "6. Merchant Service & API Keys",
      "item": [
        {
          "name": "Register Merchant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"businessName\": \"Acme Payments Inc\",\n  \"businessType\": \"E_COMMERCE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/merchants", "host": ["{{baseUrl}}"], "path": ["api", "v1", "merchants"] }
          }
        },
        {
          "name": "Get Merchant Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "merchants", "{{merchantId}}"] }
          }
        },
        {
          "name": "Generate API Key (One-time Raw Secret)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Production Webhook Key\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/api-keys", "host": ["{{baseUrl}}"], "path": ["api", "v1", "merchants", "{{merchantId}}", "api-keys"] }
          }
        },
        {
          "name": "List Merchant API Keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/api-keys", "host": ["{{baseUrl}}"], "path": ["api", "v1", "merchants", "{{merchantId}}", "api-keys"] }
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/api-keys/80f885d2-b287-4b08-b529-e26bc634cbb5", "host": ["{{baseUrl}}"], "path": ["api", "v1", "merchants", "{{merchantId}}", "api-keys", "80f885d2-b287-4b08-b529-e26bc634cbb5"] }
          }
        }
      ]
    },
    {
      "name": "7. Fraud & Risk Engine",
      "item": [
        {
          "name": "Evaluate Transaction Risk",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"amount\": 250.00,\n  \"currency\": \"INR\",\n  \"ipAddress\": \"192.168.1.50\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/fraud/evaluate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "fraud", "evaluate"] }
          }
        },
        {
          "name": "Add to Blacklist (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"IP_ADDRESS\",\n  \"targetValue\": \"198.51.100.24\",\n  \"reason\": \"Known credential stuffing origin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/fraud/blacklist", "host": ["{{baseUrl}}"], "path": ["api", "v1", "fraud", "blacklist"] }
          }
        },
        {
          "name": "Get Flagged Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/fraud/flagged/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "fraud", "flagged", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "8. Notification Service",
      "item": [
        {
          "name": "Dispatch Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"type\": \"EMAIL\",\n  \"subject\": \"Payment Received - INR 250.00\",\n  \"content\": \"Your wallet received 250.00 INR from Alice Smith.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/notifications/send", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notifications", "send"] }
          }
        },
        {
          "name": "Get Notification History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/notifications/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notifications", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "9. Actuator & Observability",
      "item": [
        {
          "name": "System Health Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "Micrometer Metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/metrics", "host": ["{{baseUrl}}"], "path": ["actuator", "metrics"] }
          }
        },
        {
          "name": "Prometheus Scrape Exposition",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/prometheus", "host": ["{{baseUrl}}"], "path": ["actuator", "prometheus"] }
          }
        }
      ]
    }
  ]
}
